                 / cmd-param-set-many

; mod-host: include/mod-host.h EFFECT_ADD; extended by plugin-hostd
; form 1: mod-host; form 2: plugin-hostd; form 3: plugin-hostd; form 4: plugin-hostd; form 5: plugin-hostd
cmd-add                  = (%s"add" SP word SP int tail) / (%s"add" SP word SP int) / (%s"add" SP word SP int SP word) / (%s"add" SP word SP int SP word) / (%s"add" SP word SP int SP word SP word)
; mod-host: include/mod-host.h BUNDLE_ADD
cmd-bundle-add           = %s"bundle_add" SP word
; mod-host: include/mod-host.h BUNDLE_REMOVE
cmd-bundle-remove        = %s"bundle_remove" SP word SP word
; mod-host: include/mod-host.h EFFECT_BYPASS
cmd-bypass               = %s"bypass" SP int SP int
; mod-host: include/mod-host.h CC_MAP
cmd-cc-map               = %s"cc_map" SP int SP word SP int SP int SP word SP float SP float SP float SP int SP int SP word SP int tail
; mod-host: include/mod-host.h CC_UNMAP
cmd-cc-unmap             = %s"cc_unmap" SP int SP word
; mod-host: include/mod-host.h CC_VALUE_SET
cmd-cc-value-set         = %s"cc_value_set" SP int SP word SP float
; mod-host: include/mod-host.h EFFECT_CONNECT
cmd-connect              = %s"connect" SP word SP word
; mod-host: include/mod-host.h CPU_LOAD
cmd-cpu-load             = %s"cpu_load"
; mod-host: include/mod-host.h CV_MAP
cmd-cv-map               = %s"cv_map" SP int SP word SP word SP float SP float SP word
; mod-host: include/mod-host.h CV_UNMAP
cmd-cv-unmap             = %s"cv_unmap" SP int SP word
; mod-host: include/mod-host.h EFFECT_DISCONNECT
cmd-disconnect           = %s"disconnect" SP word SP word
; mod-host: include/mod-host.h FEATURE_ENABLE
cmd-feature-enable       = %s"feature_enable" SP word SP int
; mod-host: include/mod-host.h HELP
cmd-help                 = %s"help"
; mod-host: include/mod-host.h HMI_MAP
cmd-hmi-map              = %s"hmi_map" SP int SP word SP int SP int SP int SP int SP int SP word SP float SP float SP int
; mod-host: include/mod-host.h HMI_UNMAP
cmd-hmi-unmap            = %s"hmi_unmap" SP int SP word
; mod-host: include/mod-host.h EFFECT_LICENSEE
cmd-licensee             = %s"licensee" SP int
; mod-host: include/mod-host.h LOAD_COMMANDS
cmd-load                 = %s"load" SP word
; mod-host: include/mod-host.h MIDI_LEARN
cmd-midi-learn           = %s"midi_learn" SP int SP word SP float SP float
; mod-host: include/mod-host.h MIDI_MAP
cmd-midi-map             = %s"midi_map" SP int SP word SP int SP int SP float SP float
; mod-host: include/mod-host.h MIDI_UNMAP
cmd-midi-unmap           = %s"midi_unmap" SP int SP word
; mod-host: include/mod-host.h MONITOR_ADDR_SET
cmd-monitor              = %s"monitor" SP word SP int SP int
; mod-host: include/mod-host.h MONITOR_MIDI_PROGRAM
cmd-monitor-midi-program = %s"monitor_midi_program" SP int SP int
; mod-host: include/mod-host.h MONITOR_OUTPUT
cmd-monitor-output       = %s"monitor_output" SP int SP word
; mod-host: include/mod-host.h OUTPUT_DATA_READY
cmd-output-data-ready    = %s"output_data_ready"
; mod-host: include/mod-host.h EFFECT_PARAM_GET
cmd-param-get            = %s"param_get" SP int SP word
; mod-host: include/mod-host.h PARAM_INFO; extended by omx-clap-core
cmd-param-info           = %s"param_info" SP int SP word
; mod-host: include/mod-host.h EFFECT_PARAM_MON
cmd-param-monitor        = %s"param_monitor" SP int SP word SP word SP float
; mod-host: include/mod-host.h EFFECT_PARAM_SET
cmd-param-set            = %s"param_set" SP int SP word SP word
; mod-host: include/mod-host.h EFFECT_PATCH_GET
cmd-patch-get            = %s"patch_get" SP int SP word
; mod-host: include/mod-host.h EFFECT_PATCH_SET
cmd-patch-set            = %s"patch_set" SP int SP word SP word
; mod-host: include/mod-host.h EFFECT_PRESET_LOAD
cmd-preset-load          = %s"preset_load" SP int SP word
; mod-host: include/mod-host.h EFFECT_PRESET_SAVE
cmd-preset-save          = %s"preset_save" SP int SP word SP word SP word
; mod-host: include/mod-host.h EFFECT_PRESET_SHOW
; form 1: mod-host; form 2: plugin-hostd (data/verbs.json PLUGIN_HOSTD_VERBS.presetShow)
cmd-preset-show          = (%s"preset_show" SP word) / (%s"preset_show" SP int SP word)
; mod-host: include/mod-host.h QUIT
cmd-quit                 = %s"quit"
; mod-host: include/mod-host.h REMOTE_PAGE_GET; extended by omx-clap-core
cmd-remote-page-get      = %s"remote_page_get" SP int SP int
; mod-host: include/mod-host.h REMOTE_PAGES; extended by omx-clap-core
cmd-remote-pages         = %s"remote_pages" SP int
; mod-host: include/mod-host.h EFFECT_REMOVE
cmd-remove               = %s"remove" SP int
; mod-host: include/mod-host.h SAVE_COMMANDS
cmd-save                 = %s"save" SP word
; mod-host: include/mod-host.h EFFECT_SET_BPB
cmd-set-bpb              = %s"set_bpb" SP float
; mod-host: include/mod-host.h EFFECT_SET_BPM
cmd-set-bpm              = %s"set_bpm" SP float
; mod-host: include/mod-host.h SHOW_EXTERNAL_UI
cmd-show-external-ui     = %s"show_external_ui" SP int
; mod-host: include/mod-host.h STATE_LOAD
cmd-state-load           = %s"state_load" SP word
; mod-host: include/mod-host.h STATE_SAVE
cmd-state-save           = %s"state_save" SP word
; mod-host: include/mod-host.h STATE_TMPDIR
cmd-state-tmpdir         = %s"state_tmpdir" SP word
; mod-host: include/mod-host.h TRACK_INFO; extended by omx-clap-core
cmd-track-info           = %s"track_info" SP int SP word SP word tail
; mod-host: include/mod-host.h TRANSPORT
cmd-transport            = %s"transport" SP int SP float SP float
; mod-host: include/mod-host.h TRANSPORT_SYNC
cmd-transport-sync       = %s"transport_sync" SP word
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_CORE_SHARED_VERBS
cmd-all-notes-off        = %s"all_notes_off" SP int
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_HOST_VERBS
cmd-audio-ports          = %s"audio_ports" SP int
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_CORE_SHARED_VERBS; sent by the daemon to a worker
cmd-chain-expect         = %s"chain_expect" SP int SP int
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_HOST_VERBS
cmd-hide-external-ui     = %s"hide_external_ui" SP int
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_HOST_VERBS
cmd-idle-hold            = %s"idle_hold" tail
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_HOST_VERBS
cmd-note-drops           = %s"note_drops" SP int
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_CORE_SHARED_VERBS
cmd-note-input           = %s"note_input" SP int
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_CORE_SHARED_VERBS
cmd-note-off             = %s"note_off" SP int SP int SP int SP int
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_CORE_SHARED_VERBS
cmd-note-on              = %s"note_on" SP int SP int SP int SP int
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_HOST_VERBS
cmd-note-out-drops       = %s"note_out_drops" SP int
; omx-clap-core: omx-clap-core data/verbs.json OMX_CLAP_CORE_SHARED_VERBS; sent by the daemon to a worker
cmd-pin-expect           = %s"pin_expect" SP int SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.chain
cmd-chain                = %s"chain" SP int SP int tail
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.chainClear
cmd-chain-clear          = %s"chain_clear" SP int
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.chainGet
cmd-chain-get            = %s"chain_get" SP int
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.descriptorGet
cmd-descriptor-get       = %s"descriptor_get" SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.estimate
cmd-estimate             = %s"estimate" SP int SP int SP word tail
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.historyClear
cmd-history-clear        = %s"history_clear" SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.historyGet
cmd-history-get          = %s"history_get" SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.instanceInfo
cmd-instance-info        = %s"instance_info" SP int
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.lv2WorkerSet
cmd-lv2-worker-set       = %s"lv2_worker_set" SP word SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.nodeLabel
cmd-node-label           = %s"node_label" SP int tail
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.panelGet
cmd-panel-get            = %s"panel_get" SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.pinAccept
cmd-pin-accept           = %s"pin_accept" SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.pinChanged
cmd-pin-changed          = %s"pin_changed" tail
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.pinClear
cmd-pin-clear            = %s"pin_clear" SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.pinLayout; sent by the daemon to a worker
cmd-pin-layout           = %s"pin_layout" SP int
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.pinReload
cmd-pin-reload           = %s"pin_reload"
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.pinSet
cmd-pin-set              = %s"pin_set" SP word SP word SP word tail
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.plan
cmd-plan                 = %s"plan" SP int SP int tail
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.planClear
cmd-plan-clear           = %s"plan_clear" SP int
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.planGet
cmd-plan-get             = %s"plan_get" SP int
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.policySet
cmd-policy-set           = %s"policy_set" SP word SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.poolConfig
cmd-pool-config          = %s"pool_config" SP word SP int
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.presetGet
cmd-preset-get           = %s"preset_get" SP int SP int
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.presetList
cmd-preset-list          = %s"preset_list" SP int
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.quarantineClear
cmd-quarantine-clear     = %s"quarantine_clear" SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.supervisorReset
; form 1: plugin-hostd; form 2: plugin-hostd; form 3: plugin-hostd
cmd-supervisor-reset     = (%s"supervisor_reset") / (%s"supervisor_reset" SP word) / (%s"supervisor_reset" SP %s"all")
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.workerEnv
cmd-worker-env           = %s"worker_env" SP word SP word SP word
; plugin-hostd: data/verbs.json PLUGIN_HOSTD_VERBS.workerList
cmd-worker-list          = %s"worker_list"
; plugin-hostd-protocol: data/verbs.json PLUGIN_HOSTD_PROTOCOL_VERBS.curveBind
cmd-curve-bind           = %s"curve_bind" SP int SP int SP word tail
; plugin-hostd-protocol: data/verbs.json PLUGIN_HOSTD_PROTOCOL_VERBS.curvePoints
cmd-curve-points         = %s"curve_points" SP int SP int SP int
; plugin-hostd-protocol: data/verbs.json PLUGIN_HOSTD_PROTOCOL_VERBS.hello
cmd-hello                = %s"hello" SP int tail
; plugin-hostd-protocol: data/verbs.json PLUGIN_HOSTD_PROTOCOL_VERBS.monitorOutputOff
cmd-monitor-output-off   = %s"monitor_output_off" SP int SP word
; plugin-hostd-protocol: data/verbs.json PLUGIN_HOSTD_PROTOCOL_VERBS.paramGetMany
cmd-param-get-many       = %s"param_get_many" SP int SP word tail
; plugin-hostd-protocol: data/verbs.json PLUGIN_HOSTD_PROTOCOL_VERBS.paramSetMany
cmd-param-set-many       = %s"param_set_many" SP int SP word SP float tail

; words a client of mod-ui may send that no host answers; each is refused and has no rule: set_midi_program_change_pedalboard_bank_channel, set_midi_program_change_pedalboard_snapshot_channel

feedback         = fb-output-set
                 / fb-remote-pages-changed
                 / fb-abi-clobber
                 / fb-chain-formed
                 / fb-chain-refused
                 / fb-chain-stalled
                 / fb-instance-quarantined
                 / fb-instance-replay-refused
                 / fb-instance-restored
                 / fb-instance-verb-dropped
                 / fb-lv2-adapter-refused
                 / fb-param-gesture
                 / fb-param-set
                 / fb-pin-changed
                 / fb-plan-reason
                 / fb-remote-page-suggest
                 / fb-supervisor-gave-up
                 / fb-worker-backoff
                 / fb-worker-died
                 / fb-worker-respawned
                 / fb-xruns

; mod-host
fb-output-set              = %s"output_set" SP int SP word SP float
; mod-host: <instance>
fb-remote-pages-changed    = %s"remote_pages_changed" SP int
; plugin-hostd: <instance> <mask> <registers> <call> <block>
fb-abi-clobber             = %s"abi_clobber" SP int SP word SP word SP word SP word
; plugin-hostd: <chain> <worker> <instance>,...
fb-chain-formed            = %s"chain_formed" SP word SP word SP word
; plugin-hostd: <chain> <code>
fb-chain-refused           = %s"chain_refused" SP word SP int
; plugin-hostd: <chain> <instance | -> <step> <code>
fb-chain-stalled           = %s"chain_stalled" SP word SP word SP word SP int
; plugin-hostd: <instance> <worker>
fb-instance-quarantined    = %s"instance_quarantined" SP int SP word
; plugin-hostd: <instance> <code>
fb-instance-replay-refused = %s"instance_replay_refused" SP int SP int
; plugin-hostd: <instance> <worker>
fb-instance-restored       = %s"instance_restored" SP int SP word
; plugin-hostd: <instance> <the command as sent> | <instance> suspect:<ms> <the command as sent>
fb-instance-verb-dropped   = (%s"instance_verb_dropped" SP int tail) / (%s"instance_verb_dropped" SP int SP word tail)
; plugin-hostd: <uri> <reason> omx-clap-host
fb-lv2-adapter-refused     = %s"lv2_adapter_refused" SP word SP word SP %s"omx-clap-host"
; plugin-hostd: <instance> <symbol> begin | end
fb-param-gesture           = %s"param_gesture" SP int SP word SP (%s"begin" / %s"end")
; plugin-hostd: <instance> <symbol> <value>
fb-param-set               = %s"param_set" SP int SP word SP word
; plugin-hostd: <uri> files | layout
fb-pin-changed             = %s"pin_changed" SP word SP (%s"files" / %s"layout")
; plugin-hostd: <chain> <instance>:<reason>,...
fb-plan-reason             = %s"plan_reason" SP int SP word
; plugin-hostd: <instance> <page_id>
fb-remote-page-suggest     = %s"remote_page_suggest" SP int SP word
; plugin-hostd: <worker> <deaths> <window_ms>
fb-supervisor-gave-up      = %s"supervisor_gave_up" SP word SP int SP int
; plugin-hostd: <worker> <ms>
fb-worker-backoff          = %s"worker_backoff" SP word SP int
; plugin-hostd: <worker> <pid> <exit:N | signal:N> <instance>,...
fb-worker-died             = %s"worker_died" SP word SP int SP word SP word
; plugin-hostd: <worker> <pid> <replayed_count> <ms>
fb-worker-respawned        = %s"worker_respawned" SP word SP int SP int SP int
; plugin-hostd: <count>
fb-xruns                   = %s"xruns" SP word

; the replies the table types, a rule per verb (reply_forms); the reply rule above still takes any resp line
typed-reply      = rp-preset-show
                 / rp-chain-get
                 / rp-descriptor-get
                 / rp-estimate
                 / rp-history-get
                 / rp-instance-info
                 / rp-panel-get
                 / rp-pin-layout
                 / rp-plan
                 / rp-plan-get
                 / rp-preset-get
                 / rp-preset-list
                 / rp-worker-list
                 / rp-curve-points
                 / rp-hello
                 / rp-param-get-many

rp-preset-show    = %s"resp" SP %s"0" tail
rp-chain-get      = %s"resp" SP %s"0" SP word SP word SP word
rp-descriptor-get = %s"resp" SP %s"0" SP word
rp-estimate       = (%s"resp" SP %s"0" SP int SP word SP word SP word SP word SP word) / (%s"resp" SP %s"0" SP int SP word SP word SP word SP word SP word SP word SP word SP word SP word)
rp-history-get    = %s"resp" SP %s"0" SP word
rp-instance-info  = %s"resp" SP %s"0" SP word SP int SP word SP word SP word
rp-panel-get      = %s"resp" SP %s"0" SP word
rp-pin-layout     = %s"resp" SP %s"0" SP word
rp-plan           = (%s"resp" SP %s"0" SP word) / (%s"resp" SP %s"0" SP word SP word)
rp-plan-get       = (%s"resp" SP %s"0" SP word SP word) / (%s"resp" SP %s"0" SP word SP word SP word)
rp-preset-get     = %s"resp" SP %s"0" SP word SP word
rp-preset-list    = %s"resp" SP int
rp-worker-list    = %s"resp" SP int *(SP word)
rp-curve-points   = %s"resp" SP %s"0" SP word *(SP word)
rp-hello          = %s"resp" SP %s"0" SP int *(SP word)
rp-param-get-many = %s"resp" SP %s"0" *(SP word)

; the extensions hello grants, and hello's reply: the daemon's version, then each extension it grants, once and in
; this order
extension        = ext-tags / ext-errors / ext-seq
ext-tags         = %s"tags"
ext-errors       = %s"errors"
ext-seq          = %s"seq"
hello-reply      = %s"resp" SP %s"0" SP int [SP ext-tags] [SP ext-errors] [SP ext-seq]

; a refusal in a session granted errors: its number, then the code the table declares for that number
error-reply      = %s"resp -1 reply.host.instance-invalid"
                 / %s"resp -3 reply.host.instance-non-exists"
                 / %s"resp -103 reply.host.param-symbol-invalid"
                 / %s"resp -501 reply.plugin-hostd.placement-invalid"
                 / %s"resp -502 reply.plugin-hostd.no-backend"
                 / %s"resp -503 reply.plugin-hostd.worker-spawn"
                 / %s"resp -504 reply.plugin-hostd.replay"
                 / %s"resp -505 reply.plugin-hostd.gave-up"
                 / %s"resp -506 reply.plugin-hostd.no-such-worker"
                 / %s"resp -507 reply.plugin-hostd.verb-dropped"
                 / %s"resp -508 reply.host.pin-absent"
                 / %s"resp -509 reply.plugin-hostd.pin-binary-mismatch"
                 / %s"resp -510 reply.host.pin-layout-mismatch"
                 / %s"resp -511 reply.host.no-param-contract"
                 / %s"resp -512 reply.plugin-hostd.lv2-adapter-refused"
                 / %s"resp -513 reply.host.no-note-input"
                 / %s"resp -514 reply.host.notes-by-jack"
                 / %s"resp -515 reply.plugin-hostd.no-preset-list"
                 / %s"resp -516 reply.plugin-hostd.pin-refused"
                 / %s"resp -517 reply.host.note-queue-full"
                 / %s"resp -518 reply.plugin-hostd.chain-unknown-instance"
                 / %s"resp -519 reply.plugin-hostd.chain-duplicate"
                 / %s"resp -520 reply.plugin-hostd.chain-instance-busy"
                 / %s"resp -521 reply.plugin-hostd.chain-mixed-format"
                 / %s"resp -522 reply.plugin-hostd.no-such-chain"
                 / %s"resp -523 reply.plugin-hostd.preset-not-offered"
                 / %s"resp -524 reply.plugin-hostd.preset-invalid"
                 / %s"resp -525 reply.plugin-hostd.preset-needs-state"
                 / %s"resp -526 reply.plugin-hostd.preset-plugin-changed"
                 / %s"resp -527 reply.plugin-hostd.load-refused"
                 / %s"resp -528 reply.plugin-hostd.dir-not-writable"
                 / %s"resp -529 reply.plugin-hostd.descriptor-absent"
                 / %s"resp -530 reply.plugin-hostd.descriptor-pending"
                 / %s"resp -531 reply.plugin-hostd.descriptor-scan-failed"
                 / %s"resp -532 reply.plugin-hostd.no-such-plan"
                 / %s"resp -533 reply.plugin-hostd.no-record"
                 / %s"resp -534 reply.plugin-hostd.no-cell"
                 / %s"resp -535 reply.plugin-hostd.unknown-plugin"
                 / %s"resp -536 reply.plugin-hostd.curve-kind-unknown"
                 / %s"resp -537 reply.plugin-hostd.curve-term-missing"
                 / %s"resp -538 reply.plugin-hostd.curve-unit-refused"
                 / %s"resp -539 reply.plugin-hostd.curve-points-range"
                 / %s"resp -540 reply.plugin-hostd.durable-write-failed"
                 / %s"resp -541 reply.plugin-hostd.writer-queue-full"
                 / %s"resp -542 reply.plugin-hostd.curve-value-not-finite"
                 / %s"resp -543 reply.plugin-hostd.output-not-monitored"
                 / %s"resp -544 reply.plugin-hostd.preset-not-applied"
                 / %s"resp -545 reply.plugin-hostd.label-invalid"
                 / %s"resp -901 reply.host.memory-allocation"
                 / %s"resp -902 reply.host.invalid-operation"

; mod-host's parse refusals, written as their message
protocol-error   = %s"not found" / %s"many arguments" / %s"few arguments" / %s"invalid argument"
