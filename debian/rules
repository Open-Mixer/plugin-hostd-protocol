#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

MAKE_VARS = PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH)

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- $(MAKE_VARS)

override_dh_auto_install:
	dh_auto_install -- $(MAKE_VARS)
	# the domains of plugin-hostd-protocol (contract.d/plugin-hostd, probe, pin, estimate), as omx-contract's contract directory holds them
	$(MAKE) install-contract DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr
	# the Python packages, python3-plugin-hostd-client and python3-plugin-hostd-protocol
	$(MAKE) install-python DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr PYTHON3_SITELIB=/usr/lib/python3/dist-packages

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) test
endif
