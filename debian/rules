#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

MAKE_VARS = PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH)

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- $(MAKE_VARS)
	# the TypeScript codec's dist/, which the npm package's own export is
	$(MAKE) build-node

override_dh_auto_install:
	dh_auto_install -- $(MAKE_VARS)
	# the domains of plugin-hostd-protocol (contract.d/plugin-hostd-protocol, host, hosting-verb, probe, pin, estimate), as omx-contract's contract directory holds them
	$(MAKE) install-contract DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr
	# the Python packages, python3-plugin-hostd-client and python3-plugin-hostd-protocol
	$(MAKE) install-python DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr PYTHON3_SITELIB=/usr/lib/python3/dist-packages
	# the npm package's packed tree, nodejs-plugin-hostd-protocol
	$(MAKE) install-node DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr NODEDIR=/usr/lib/node_modules

# dh_fixperms resets every mode under usr/lib to 0644, so the npm package's own bin (#! cli.js) loses the mode install-node gave it and
# lintian fails the build on script-not-executable: every installed file of the packed tree that starts with #! is made 0755 again after it
override_dh_fixperms:
	dh_fixperms
	find debian/nodejs-plugin-hostd-protocol/usr/lib/node_modules -path '*/node_modules/@openmixer/plugin-hostd-protocol/node_modules' -prune -o -type f -exec sh -c 'for f; do [ "$$(head -c2 "$$f")" = "#!" ] && chmod 0755 "$$f"; done; :' sh {} +

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) test
	# the packed tree as a Node consumer imports it: the bare name and ./client resolve, every codec vector is met
	$(MAKE) test-node-installed PREFIX=/usr
endif
