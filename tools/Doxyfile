# The documentation gate (tools/doxygen_gate.sh): doxygen warns for each public symbol of the installed headers without a
# doc block, and for each parameter without @param. Nothing is generated.
PROJECT_NAME           = plugin-hostd-protocol
INPUT                  = include/host-backend.h include/host-dispatch.h include/host-errors.h include/mod-host.h \
                         include/host-scenario.h include/protocol.h include/socket.h include/utils.h \
                         include/plugin-hostd/protocol.h include/plugin-hostd/search_paths.h
FILE_PATTERNS          = *.h
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: warning: $text"
WARN_LOGFILE           = $(DOXYGEN_LOG)
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
QUIET                  = YES
