{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmixer.org/schema/plugin-hostd-protocol/reply_curve_points.schema.json",
  "title": "CurvePointsReply",
  "description": "The parsed form of a curve_points reply (the points of a bound display): one property per word of the reply, a list an array, a record an object, a whole number or a decimal one a number.",
  "type": "object",
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "The number of points that follow."
    },
    "marks": {
      "type": "array",
      "description": "The bands a corrector planted, in band order: none when the host gives every bound term the origin user.",
      "items": {
        "type": "object",
        "title": "Mark",
        "description": "A band a corrector planted.",
        "properties": {
          "freq": {
            "type": "number",
            "description": "The band's frequency in Hz."
          },
          "depth": {
            "type": "number",
            "description": "The band's depth in dB."
          },
          "q": {
            "type": "number",
            "description": "The band's Q."
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "description": "Where the band comes from, omx-dsp's CURVE_ORIGINS word."
          }
        },
        "required": [
          "freq",
          "depth",
          "q",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "points": {
      "type": "array",
      "description": "The curve's points, ascending in x.",
      "items": {
        "type": "object",
        "title": "Point",
        "description": "One point of a curve.",
        "properties": {
          "x": {
            "type": "number",
            "description": "The x of the point."
          },
          "y": {
            "type": "number",
            "description": "The y of the point."
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "count",
    "marks",
    "points"
  ],
  "additionalProperties": false
}
