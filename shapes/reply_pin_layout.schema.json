{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Mixer/plugin-hostd-protocol/shapes/reply_pin_layout.schema.json",
  "title": "PinLayoutReply",
  "description": "The parsed form of a pin_layout reply (the layout pin): one property per word of the reply, a list an array, a record an object, a whole number or a decimal one a number.",
  "type": "object",
  "properties": {
    "layout": {
      "type": "object",
      "title": "Layout",
      "description": "A layout pin.",
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1,
          "description": "The layout pin's scheme."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the layout, 64 lowercase hexadecimal digits."
        }
      },
      "required": [
        "scheme",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "layout"
  ],
  "additionalProperties": false
}
