{
  "name": "@openmixer/plugin-hostd-protocol",
  "version": "0.6.0",
  "description": "The plugin-hostd protocol's reply shapes (a JSON Schema and a TypeScript type for each document a reply carries, rendered from the schemas by omx-contract's pinned generator) and its thin TypeScript client: the transport, the generated vocabulary and curvePoints",
  "license": "GPL-3.0-or-later",
  "author": "Pau Aliagas <linuxnow@gmail.com>",
  "homepage": "https://www.openmixer.org/projects/plugin-hostd-protocol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Mixer/plugin-hostd-protocol.git"
  },
  "exports": {
    "./shapes/*": {
      "types": "./ts/shapes/*.d.ts"
    },
    "./schemas/*": "./shapes/*.schema.json",
    "./client": {
      "types": "./clients/typescript/client.d.mts",
      "default": "./clients/typescript/client.mjs"
    },
    "./lines": {
      "types": "./clients/typescript/lines.d.mts",
      "default": "./clients/typescript/lines.mjs"
    },
    "./vocabulary": {
      "types": "./clients/typescript/vocabulary.d.mts",
      "default": "./clients/typescript/vocabulary.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "ts/shapes/",
    "clients/typescript/",
    "shapes/",
    "COPYING"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
